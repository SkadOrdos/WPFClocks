<Window x:Class="WClocks.GeoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set GeoCoordinates"
        Width="530"
        Height="210"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Enter your city name:" Margin="0,0,0,6"/>

        <ComboBox x:Name="CityComboBox"
                  Grid.Row="1"
                  IsEditable="True"
                  IsTextSearchEnabled="False"
                  StaysOpenOnEdit="True"
                  Height="30"
                  SelectionChanged="CityComboBox_SelectionChanged"
                  KeyDown="CityComboBox_KeyDown"/>

        <Button Grid.Row="2"
                Content="Search"
                Width="100"
                Height="27"
                HorizontalAlignment="Right"
                Margin="0,10,0,10"
                Click="SearchButton_Click"/>

        <StackPanel Grid.Row="3">
            <TextBlock x:Name="CoordinatesText"
                       Text="Latitude: —; Longitude: —"
                       Margin="0,0,0,6"/>

            <TextBlock Text="Data © OpenStreetMap" FontSize="11" Foreground="Gray"/>
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,11,0,0">

            <Button Content="Apply" Width="90" IsDefault="True" Margin="0,0,8,0" Click="OkButton_Click"/>
            <Button Content="Cancel" Width="90" IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
